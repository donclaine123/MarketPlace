# Supabase project settings > Data API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase project settings > API Keys > Secret key (server only)
SUPABASE_SECRET_KEY=
# Set true only to preview the read-only sample catalog without Supabase.
MARKETPLACE_DEMO=true

# Stripe sandbox only. Keep secret keys on the server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public production URL. Development redirects use the local request origin.
APP_URL=https://YOUR-APP.vercel.app
